NACOS_AUTH_TOKEN=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=onecard-local

# Enable only after provisioning the isolated account schema and its two users.
ACCOUNT_DB_ENABLED=false
ACCOUNT_DB_URL=jdbc:mysql://onecard-oceanbase:2881/onecard_account
ACCOUNT_DB_USERNAME=onecard_account_app
ACCOUNT_DB_PASSWORD=REPLACE_WITH_ACCOUNT_RUNTIME_SECRET
ACCOUNT_DB_MIGRATION_URL=jdbc:mysql://onecard-oceanbase:2881/onecard_account
ACCOUNT_DB_MIGRATION_USERNAME=onecard_account_migrator
ACCOUNT_DB_MIGRATION_PASSWORD=REPLACE_WITH_ACCOUNT_MIGRATION_SECRET
ACCOUNT_DB_SCHEMA=onecard_account

# Enable only after provisioning the isolated transaction schema and its users.
TRANSACTION_DB_ENABLED=false
TRANSACTION_DB_URL=jdbc:mysql://onecard-oceanbase:2881/onecard_transaction
TRANSACTION_DB_USERNAME=onecard_transaction_app
TRANSACTION_DB_PASSWORD=REPLACE_WITH_TRANSACTION_RUNTIME_SECRET
TRANSACTION_DB_MIGRATION_URL=jdbc:mysql://onecard-oceanbase:2881/onecard_transaction
TRANSACTION_DB_MIGRATION_USERNAME=onecard_transaction_migrator
TRANSACTION_DB_MIGRATION_PASSWORD=REPLACE_WITH_TRANSACTION_MIGRATION_SECRET
TRANSACTION_DB_SCHEMA=onecard_transaction
